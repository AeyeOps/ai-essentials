{
  "name": "memory-chart",
  "displayName": "Memory Chart",
  "description": "Live-updating chart of system memory usage in a webview panel",
  "version": "0.1.0",
  "publisher": "my-publisher",
  "engines": {
    "vscode": "^1.110.0"
  },
  "categories": [
    "Visualization"
  ],
  "main": "./dist/extension",
  "activationEvents": [
    "onWebviewPanel:memoryChart"
  ],
  "contributes": {
    "commands": [
      {
        "command": "memoryChart.show",
        "title": "Show Memory Chart",
        "category": "Memory Chart",
        "icon": "$(pulse)"
      }
    ],
    "configuration": {
      "title": "Memory Chart",
      "properties": {
        "memoryChart.pollInterval": {
          "type": "number",
          "default": 2000,
          "description": "How often to sample memory usage (milliseconds)"
        },
        "memoryChart.maxDataPoints": {
          "type": "number",
          "default": 60,
          "description": "Maximum number of data points to display on the chart"
        }
      }
    }
  },
  "scripts": {
    "compile": "npm run check-types && node esbuild.js",
    "check-types": "tsc --noEmit",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && node esbuild.js --production",
    "vscode:prepublish": "npm run package",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.110.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.0",
    "esbuild": "^0.25.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.7.0"
  }
}
