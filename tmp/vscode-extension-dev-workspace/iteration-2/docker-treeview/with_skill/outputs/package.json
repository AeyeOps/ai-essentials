{
  "name": "docker-treeview",
  "displayName": "Docker TreeView",
  "description": "Explorer sidebar tree view showing running Docker containers with colored status dots and one-click log viewing",
  "version": "0.1.0",
  "publisher": "local",
  "engines": {
    "vscode": "^1.110.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "docker",
    "containers",
    "treeview",
    "logs"
  ],
  "main": "./dist/extension",
  "activationEvents": [],
  "contributes": {
    "views": {
      "explorer": [
        {
          "id": "dockerContainers",
          "name": "Docker Containers"
        }
      ]
    },
    "commands": [
      {
        "command": "dockerTreeView.refresh",
        "title": "Refresh",
        "icon": "$(refresh)",
        "category": "Docker TreeView"
      },
      {
        "command": "dockerTreeView.openLogs",
        "title": "Open Container Logs",
        "icon": "$(terminal)",
        "category": "Docker TreeView"
      },
      {
        "command": "dockerTreeView.startContainer",
        "title": "Start Container",
        "icon": "$(play)",
        "category": "Docker TreeView"
      },
      {
        "command": "dockerTreeView.stopContainer",
        "title": "Stop Container",
        "icon": "$(debug-stop)",
        "category": "Docker TreeView"
      },
      {
        "command": "dockerTreeView.restartContainer",
        "title": "Restart Container",
        "icon": "$(debug-restart)",
        "category": "Docker TreeView"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "dockerTreeView.refresh",
          "when": "view == dockerContainers",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "dockerTreeView.openLogs",
          "when": "view == dockerContainers",
          "group": "inline@1"
        },
        {
          "command": "dockerTreeView.startContainer",
          "when": "view == dockerContainers && viewItem == stopped",
          "group": "inline@2"
        },
        {
          "command": "dockerTreeView.stopContainer",
          "when": "view == dockerContainers && viewItem == running",
          "group": "inline@2"
        },
        {
          "command": "dockerTreeView.restartContainer",
          "when": "view == dockerContainers",
          "group": "context@1"
        },
        {
          "command": "dockerTreeView.openLogs",
          "when": "view == dockerContainers",
          "group": "context@2"
        },
        {
          "command": "dockerTreeView.startContainer",
          "when": "view == dockerContainers && viewItem == stopped",
          "group": "context@3"
        },
        {
          "command": "dockerTreeView.stopContainer",
          "when": "view == dockerContainers && viewItem == running",
          "group": "context@4"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "dockerContainers",
        "contents": "No Docker containers found.\nMake sure Docker is running.\n[Refresh](command:dockerTreeView.refresh)"
      }
    ],
    "configuration": {
      "title": "Docker TreeView",
      "properties": {
        "dockerTreeView.refreshInterval": {
          "type": "number",
          "default": 5000,
          "description": "Auto-refresh interval in milliseconds (0 to disable)"
        },
        "dockerTreeView.showAllContainers": {
          "type": "boolean",
          "default": true,
          "description": "Show all containers (including stopped). When false, only running containers are shown."
        }
      }
    }
  },
  "scripts": {
    "compile": "npm run check-types && node esbuild.js",
    "check-types": "tsc --noEmit",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && node esbuild.js --production",
    "vscode:prepublish": "npm run package",
    "lint": "eslint src/"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.110.0",
    "esbuild": "^0.25.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.7.0"
  }
}
