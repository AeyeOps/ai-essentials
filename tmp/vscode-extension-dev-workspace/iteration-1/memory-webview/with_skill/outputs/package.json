{
  "name": "memory-monitor",
  "displayName": "Memory Monitor",
  "description": "Live-updating chart of system memory usage in a webview panel",
  "version": "0.1.0",
  "publisher": "my-publisher",
  "engines": {
    "vscode": "^1.110.0"
  },
  "categories": [
    "Visualization"
  ],
  "keywords": [
    "memory",
    "monitor",
    "system",
    "chart",
    "performance"
  ],
  "main": "./dist/extension",
  "activationEvents": [
    "onWebviewPanel:memoryMonitor"
  ],
  "contributes": {
    "commands": [
      {
        "command": "memoryMonitor.show",
        "title": "Show Memory Monitor",
        "icon": "$(dashboard)",
        "category": "Memory Monitor"
      }
    ],
    "configuration": {
      "title": "Memory Monitor",
      "properties": {
        "memoryMonitor.pollInterval": {
          "type": "number",
          "default": 2000,
          "minimum": 500,
          "maximum": 30000,
          "description": "How often to poll memory usage, in milliseconds"
        },
        "memoryMonitor.maxDataPoints": {
          "type": "number",
          "default": 60,
          "minimum": 10,
          "maximum": 600,
          "description": "Maximum number of data points to display on the chart"
        }
      }
    }
  },
  "scripts": {
    "compile": "npm run check-types && node esbuild.js",
    "check-types": "tsc --noEmit",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && node esbuild.js --production",
    "vscode:prepublish": "npm run package",
    "test": "vscode-test",
    "lint": "eslint src/"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.110.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1",
    "esbuild": "^0.24.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.7.0"
  }
}
