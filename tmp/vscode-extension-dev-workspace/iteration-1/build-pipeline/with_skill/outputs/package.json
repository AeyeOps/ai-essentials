{
  "name": "my-sample-extension",
  "displayName": "My Sample Extension",
  "description": "A sample VS Code extension with esbuild, testing, and marketplace-ready configuration",
  "version": "0.1.0",
  "publisher": "my-publisher-id",
  "engines": {
    "vscode": "^1.110.0"
  },
  "categories": [
    "Other"
  ],
  "pricing": "Free",
  "main": "./dist/extension",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "mySampleExtension.helloWorld",
        "title": "Hello World",
        "category": "My Sample Extension"
      }
    ]
  },
  "scripts": {
    "compile": "npm run check-types && node esbuild.js",
    "compile:tests": "tsc -p tsconfig.json",
    "check-types": "tsc --noEmit",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && node esbuild.js --production",
    "vscode:prepublish": "npm run package",
    "test": "npm run compile:tests && vscode-test",
    "test:unit": "npm run compile:tests && vscode-test --label unit",
    "test:integration": "npm run compile:tests && vscode-test --label integration",
    "lint": "eslint src/"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.110.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.24.0",
    "eslint": "^9.0.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.7.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/my-user/my-sample-extension"
  },
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  }
}
